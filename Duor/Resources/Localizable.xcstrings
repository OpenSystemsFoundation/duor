{
  "sourceLanguage" : "en",
  "strings" : {
    "A cat joins every scene behind the door, each one up to something different." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في كل مشهد خلف الباب قطة، وكل واحدة منها مشغولة بشيء مختلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinter der Tür lebt in jeder Szene eine Katze, und jede hat etwas anderes vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cada escena detrás de la puerta vive un gato, y cada uno está tramando algo distinto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chat se cache dans chaque décor derrière la porte, et chacun mijote quelque chose de différent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ogni scena dietro la porta c’è un gatto, e ognuno combina qualcosa di diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドアの向こうのどのシーンにも猫がいて、それぞれ違うことをしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문 뒤의 모든 장면에 고양이가 한 마리씩 있고, 저마다 다른 일을 꾸미고 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In elke scène achter de deur woont een kat, en elke kat voert iets anders uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W każdej scenie za drzwiami pojawia się kot, a każdy z nich coś knuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um gato aparece em cada cena atrás da porta, cada um aprontando algo diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В каждой сцене за дверью живёт кошка, и каждая занята чем-то своим."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapının ardındaki her sahnede bir kedi var ve her biri başka bir şeyin peşinde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "门后的每个场景里都有一只猫，每只都在忙着不同的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "門後的每個場景裡都有一隻貓，每隻都在忙著不同的事。"
          }
        }
      }
    },
