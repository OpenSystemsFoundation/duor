    "Swipe left to open the door" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لليسار لفتح الباب"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach links wischen, um die Tür zu öffnen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda para abrir la puerta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche pour ouvrir la porte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a sinistra per aprire la porta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左にスワイプしてドアを開ける"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽으로 쓸어 문 열기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links om de deur te openen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w lewo, aby otworzyć drzwi"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda para abrir a porta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните влево, чтобы открыть дверь"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapıyı açmak için sola kaydırın"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左轻扫以开门"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左滑動來開門"
          }
        }
      }
    },
    "Swipe left to open the door and right to close it, folded or unfolded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لليسار لفتح الباب ولليمين لإغلاقه، سواء كان الجهاز مطويًا أو مفتوحًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach links, um die Tür zu öffnen, und nach rechts, um sie zu schließen – zugeklappt oder aufgeklappt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda para abrir la puerta y a la derecha para cerrarla, plegado o desplegado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche pour ouvrir la porte et vers la droite pour la fermer, plié ou déplié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a sinistra per aprire la porta e a destra per chiuderla, a telefono chiuso o aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左にスワイプするとドアが開き、右にスワイプすると閉まります。折りたたんでいても開いていても使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽으로 쓸면 문이 열리고 오른쪽으로 쓸면 닫힙니다. 접혀 있을 때도, 펼쳐져 있을 때도 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links om de deur te openen en naar rechts om hem te sluiten, dichtgevouwen of opengevouwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w lewo, aby otworzyć drzwi, i w prawo, aby je zamknąć, po złożeniu i po rozłożeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda para abrir a porta e para a direita para fechá-la, dobrado ou desdobrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните влево, чтобы открыть дверь, и вправо, чтобы закрыть её, — в сложенном или разложенном виде."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapıyı açmak için sola, kapatmak için sağa kaydırın; telefon katlıyken de açıkken de çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左轻扫开门，向右轻扫关门，折叠或展开时都可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左滑動開門，向右滑動關門，摺疊或展開時都可以。"
          }
        }
      }
    },
