    },
    "Duor is made with love by Jeff. Like the app? Come visit the workshop and say hi!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صنع Jeff تطبيق Duor بكل حب. هل أعجبك التطبيق؟ تفضّل بزيارة الورشة وألقِ التحية!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor wurde von Jeff mit Liebe gemacht. Gefällt dir die App? Schau in der Werkstatt vorbei und sag Hallo!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor está hecho con cariño por Jeff. ¿Te gusta la app? ¡Pásate por el taller y saluda!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor est fait avec amour par Jeff. Vous aimez l’app ? Passez à l’atelier dire bonjour !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor è fatta con amore da Jeff. Ti piace l’app? Passa a trovarci in laboratorio e saluta!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DuorはJeffが心を込めて作りました。気に入っていただけたら、工房に遊びに来てください！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor는 Jeff가 정성껏 만들었어요. 앱이 마음에 드시나요? 작업실에 놀러 와서 인사해 주세요!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor is met liefde gemaakt door Jeff. Vind je de app leuk? Kom langs in de werkplaats en zeg hallo!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor powstał z miłością, a zrobił go Jeff. Podoba ci się aplikacja? Wpadnij do warsztatu i się przywitaj!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Duor é feito com carinho por Jeff. Gostou do app? Visite a oficina e diga oi!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor с любовью сделал Jeff. Нравится приложение? Загляните в мастерскую и скажите привет!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor, Jeff tarafından sevgiyle yapıldı. Uygulamayı beğendiniz mi? Atölyeye uğrayıp merhaba deyin!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor 由 Jeff 用心打造。喜欢这个 App 吗？欢迎来工作室打个招呼！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor 由 Jeff 用心打造。喜歡這個 App 嗎？歡迎來工作室打聲招呼！"
          }
        }
      }
    },
    "Duor uses your device's language. To choose another language just for Duor, change it in the Settings app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Duor لغة جهازك. لاختيار لغة أخرى لتطبيق Duor فقط، غيّرها في تطبيق الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor verwendet die Sprache deines Geräts. Um nur für Duor eine andere Sprache zu wählen, ändere sie in der App „Einstellungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor usa el idioma de tu dispositivo. Para elegir otro idioma solo para Duor, cámbialo en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor utilise la langue de votre appareil. Pour choisir une autre langue uniquement pour Duor, modifiez-la dans l’app Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor usa la lingua del tuo dispositivo. Per scegliere un’altra lingua solo per Duor, cambiala nell’app Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duorはデバイスの言語で表示されます。Duorだけ別の言語にするには、設定アプリで変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor는 기기의 언어를 사용합니다. Duor에서만 다른 언어를 쓰려면 설정 앱에서 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor gebruikt de taal van je apparaat. Wil je alleen voor Duor een andere taal, wijzig die dan in de app Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor używa języka twojego urządzenia. Aby wybrać inny język tylko dla Duor, zmień go w aplikacji Ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Duor usa o idioma do seu dispositivo. Para escolher outro idioma só para o Duor, altere-o no app Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor использует язык вашего устройства. Чтобы выбрать другой язык только для Duor, измените его в приложении «Настройки»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor, aygıtınızın dilini kullanır. Yalnızca Duor için başka bir dil seçmek isterseniz bunu Ayarlar uygulamasında değiştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor 使用你设备的语言。如果只想让 Duor 使用其他语言，请在“设置”App 中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duor 會使用你裝置的語言。若只想讓 Duor 使用其他語言，請到「設定」App 中更改。"
          }
        }
      }
    },
