    "Hinges, handle and latch. Each metal sounds a little different, too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفصلات والمقبض والمزلاج. ولكل معدن صوت مختلف قليلًا أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scharniere, Griff und Schloss. Jedes Metall klingt auch ein bisschen anders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisagras, tirador y pestillo. Además, cada metal suena un poco distinto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charnières, poignée et loquet. Chaque métal sonne aussi un peu différemment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerniere, maniglia e chiavistello. Ogni metallo ha anche un suono un po’ diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蝶番、取っ手、ラッチ。金属ごとに音も少しずつ違います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경첩, 손잡이, 걸쇠. 금속마다 소리도 조금씩 달라요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scharnieren, deurklink en schoot. Elk metaal klinkt ook een beetje anders."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawiasy, klamka i zatrzask. Każdy metal brzmi też trochę inaczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobradiças, maçaneta e trinco. E cada metal tem um som um pouco diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Петли, ручка и защёлка. И каждый металл звучит немного по-своему."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menteşeler, kol ve mandal. Her metalin sesi de biraz farklıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合页、把手和门闩。每种金属的声音也略有不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鉸鏈、把手和門閂。每種金屬的聲音也略有不同。"
          }
        }
      }
    },
